<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/homework"
        app:contentPadding="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@color/white"
        app:cardCornerRadius="@dimen/_2sdp"
        tools:context=".ui.staffHomework.assignedHomeworkList.AssignedHomeworkListFragment">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/subject_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/georgia"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/homework_subject_name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/class_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/georgia"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/homework_class_name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/homework_delete_btn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="@dimen/_2sdp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="top"
                        android:contentDescription="Delete Homework"
                        android:background="@color/transparent"
                        app:srcCompat="@drawable/ic_trash"
                        app:tint="@color/red_card" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/homework_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/georgia"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Test"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/homework_date_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/calendar_line"
                        app:tint="@color/dark_gray"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/homework_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:text="@string/homework_assigned_on_date"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:orientation="horizontal"
                    android:layout_gravity="start"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/person_line"
                        app:tint="@color/dark_gray"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/teacher_name"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/_12sdp"
                        android:text="@string/homework_assigned_by" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homework_attachment_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal"
                    android:layout_gravity="start"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/file_line"
                        app:tint="@color/black"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/attachment"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp"
                        android:text="Attachment Link" />
                </LinearLayout>
            </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>