                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_20sdp"
                    android:elevation="@dimen/_10sdp"
                    app:cardCornerRadius="@dimen/_5sdp"
                    app:cardElevation="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_school_fee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:src="@drawable/fee_school"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_school_fee_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:fontFamily="@font/georgia"
                            android:text="@string/school_fee"

                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp"
                            app:layout_constraintBottom_toBottomOf="@id/iv_school_fee"
                            app:layout_constraintStart_toEndOf="@id/iv_school_fee"
                            app:layout_constraintTop_toTopOf="@id/iv_school_fee" />


                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_installment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/georgia"
                            android:text="@string/installment"
                            android:textSize="@dimen/_15sdp"

                            app:layout_constraintStart_toStartOf="@id/tv_school_fee_label"
                            app:layout_constraintTop_toBottomOf="@id/tv_school_fee_label" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_payment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:fontFamily="@font/georgia"
                            android:text="@string/third"

                            android:textSize="@dimen/_15sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_school_fee_label" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_amount_label"
