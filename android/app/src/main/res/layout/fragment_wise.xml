<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--        This is for student and parent-->
        <ScrollView
            android:id="@+id/sv_student_wise"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/blue_background"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                tools:context=".ui.wise.WiseFragment">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/cv_student_pic"
                    android:layout_width="@dimen/_65sdp"
                    android:layout_height="@dimen/_65sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_bottom_profile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_student_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="0.6"
                    android:fontFamily="@font/georgia"
                    android:gravity="start"
                    android:text="Prabal Singh"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/iv_wise_label"
                    app:layout_constraintStart_toEndOf="@id/cv_student_pic"
                    app:layout_constraintTop_toTopOf="@id/cv_student_pic" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_student_class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="0.6"
                    android:fontFamily="@font/georgia"
                    android:gravity="start"
                    android:text="V-B"
                    android:textSize="@dimen/_13sdp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/iv_wise_label"
                    app:layout_constraintStart_toEndOf="@id/cv_student_pic"
                    app:layout_constraintTop_toBottomOf="@id/tv_student_name" />


                <LinearLayout
                    android:id="@+id/iv_wise_label"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/cv_student_pic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cv_student_pic">


                    <ImageView
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/wise" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:fontFamily="@font/georgia_italic"
                        android:gravity="end"
                        android:text="Know more"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/rl_main_wise"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_320sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/cv_student_pic">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/iv_main_wise_label"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shield_round_circle">

                        <LinearLayout
                            android:layout_width="@dimen/_150sdp"
                            android:layout_height="@dimen/_165sdp"
                            android:layout_marginTop="@dimen/_40sdp"
                            android:layout_marginEnd="@dimen/_50sdp"
                            android:background="@color/green"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="UselessParent">


                                <RelativeLayout
                                    android:id="@+id/rl_Worthy"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@color/white">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/shield_ww" />

                                    <TextView
                                        android:id="@+id/worthyTextCount"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_marginEnd="@dimen/_10sdp"
                                        android:layout_marginBottom="@dimen/_15sdp"
                                        android:background="@drawable/shield_circle"
                                        android:gravity="center"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/_10ssp" />

                                </RelativeLayout>

                                <RelativeLayout
                                    android:id="@+id/rl_Stature"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@color/white">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/shield_ss" />

                                    <TextView
                                        android:id="@+id/statureTextCount"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_alignParentTop="true"
                                        android:layout_alignParentEnd="true"
                                        android:layout_marginTop="@dimen/_15sdp"
                                        android:layout_marginEnd="@dimen/_10sdp"
                                        android:background="@drawable/shield_circle"
                                        android:gravity="center"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_10ssp" />

                                </RelativeLayout>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="UselessParent">

                                <RelativeLayout
                                    android:id="@+id/rl_Intellect"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@color/white">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/shield_ii" />

                                    <TextView
                                        android:id="@+id/intellectTextCount"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_marginStart="@dimen/_10sdp"
                                        android:layout_marginBottom="@dimen/_15sdp"
                                        android:background="@drawable/shield_circle"
                                        android:gravity="center"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_10ssp" />

                                </RelativeLayout>


                                <RelativeLayout
                                    android:id="@+id/rl_Emotion"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:background="@color/white">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/shield_ee" />

                                    <TextView
                                        android:id="@+id/emotionTextCount"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentTop="true"
                                        android:layout_marginStart="@dimen/_10sdp"
                                        android:layout_marginTop="@dimen/_15sdp"
                                        android:background="@drawable/shield_circle"
                                        android:gravity="center"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_10ssp" />

                                </RelativeLayout>

                            </LinearLayout>


                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <ImageView
                        android:id="@+id/calendar"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="@dimen/_10sdp"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_calendar"
                        android:visibility="gone" />
                </RelativeLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rl_main_wise">

                    <LinearLayout
                        android:id="@+id/linearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10sdp"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/iv_worthy"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_weight="1"
                            android:background="@drawable/worthy"
                            android:fontFamily="@font/georgia"
                            android:gravity="center"
                            android:text="Worthy"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/iv_intellect"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/intellent"
                            android:fontFamily="@font/georgia"
                            android:gravity="center"
                            android:text="Intellect"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            app:layout_constraintEnd_toStartOf="@id/iv_stature"
                            app:layout_constraintStart_toEndOf="@id/iv_worthy"
                            app:layout_constraintTop_toTopOf="@id/iv_worthy" />

                        <TextView
                            android:id="@+id/iv_stature"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/starturc"
                            android:fontFamily="@font/georgia"
                            android:gravity="center"
                            android:text="Stature"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            app:layout_constraintEnd_toStartOf="@id/iv_emotion"
                            app:layout_constraintStart_toEndOf="@id/iv_intellect"
                            app:layout_constraintTop_toTopOf="@id/iv_worthy" />

                        <TextView
                            android:id="@+id/iv_emotion"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/emotion"
                            android:fontFamily="@font/georgia"
                            android:gravity="center"
                            android:text="Emotion"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/iv_worthy" />

                        <!--   <com.google.android.material.imageview.ShapeableImageView
                               android:id="@+id/iv_shadow"
                               android:layout_width="match_parent"
                               android:layout_height="@dimen/_10sdp"
                               android:scaleType="centerInside"
                               android:src="@drawable/ic_shadow"
                               app:layout_constraintTop_toBottomOf="@id/iv_emotion" />-->


                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10sdp"
                        android:elevation="@dimen/_20sdp"
                        app:cardCornerRadius="@dimen/_5sdp"
                        app:cardElevation="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/linearLayout">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/_5sdp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/georgia_italic"
                                android:gravity="end"
                                android:text="@string/you_shall_love_the_lord_your_god_with_all_your_heart_and_with_all_your_soual_and_with_all_your_mind"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12ssp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <View
                                android:id="@+id/view"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_marginTop="@dimen/_15sdp"
                                android:background="@color/lightGrey"
                                android:visibility="gone"
                                app:layout_constraintTop_toBottomOf="@id/tv_label" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_marginBottom="@dimen/_10sdp"
                                android:fontFamily="@font/georgia_bold"
                                android:gravity="start"
                                android:text="- Jesus Christ"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12ssp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="@+id/tv_label"
                                app:layout_constraintTop_toBottomOf="@id/view" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!--        This is for Staff-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_staff_wise"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rl_class"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_1sdp"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/_1sdp"
                android:paddingBottom="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_class"
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="0dp"
                    android:background="@drawable/blue_border"
                    android:fontFamily="@font/georgia"
                    android:gravity="center"
                    android:text="Class"
                    android:textAllCaps="false"
                    android:textColor="@color/purple"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_student"
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:background="@drawable/gray_backgroud"
                    android:fontFamily="@font/georgia"
                    android:gravity="center"
                    android:text="@string/student"
                    android:textAllCaps="false"
                    android:textColor="@color/border"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_class"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/classView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_class">


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_select_classlabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/georgia"
                    android:text="Select Class"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    app:layout_constraintEnd_toStartOf="@id/cv_search"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_select_classlabel">

                    <Spinner
                        android:id="@+id/sectionList"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_arrow"
                        android:drawablePadding="@dimen/_5sdp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:maxLines="1"
                        android:padding="@dimen/_5sdp" />
                </androidx.cardview.widget.CardView>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_select_dateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:fontFamily="@font/georgia"
                    android:text="Select Date"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="@id/cv_search"
                    app:layout_constraintTop_toTopOf="@id/tv_select_classlabel" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cv_class"
                    app:layout_constraintTop_toBottomOf="@id/tv_select_dateLabel">

                    <TextView
                        android:id="@+id/edt_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawablePadding="@dimen/_5sdp"
                        android:drawableTint="@color/purple"
                        android:focusable="false"
                        android:fontFamily="@font/georgia"
                        android:hint="15-06-2020"
                        android:maxLines="1"
                        android:padding="@dimen/_10sdp"
                        android:textSize="@dimen/_14ssp" />
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_search1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="@+id/cv_search"
                    app:layout_constraintStart_toStartOf="@+id/cv_class"
                    app:layout_constraintTop_toBottomOf="@+id/cv_class">

                    <EditText
                        android:id="@+id/edt_calendar1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:drawableEnd="@drawable/ic_search"
                        android:drawablePadding="@dimen/_5sdp"
                        android:drawableTint="@color/purple"
                        android:fontFamily="@font/georgia"
                        android:hint="Search"
                        android:maxLines="1"
                        android:padding="@dimen/_8sdp"
                        android:textSize="@dimen/_12sdp" />
                </androidx.cardview.widget.CardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_studentList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toTopOf="@id/btn_save"
                    app:layout_constraintTop_toBottomOf="@id/cv_search1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/staffBackground"
                    android:fontFamily="@font/georgia"
                    android:padding="@dimen/_10sdp"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/studentView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_class">

                <LinearLayout
                    android:id="@+id/studentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@drawable/qr_code"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/studentContainer" />

                <LinearLayout
                    android:id="@+id/qrCodeScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#f0f0f0"
                    android:orientation="vertical"
                    android:padding="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/qrImage"

                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/georgia"
                        android:gravity="center"
                        android:text="Student"
                        android:textSize="@dimen/_12ssp"

                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/georgia"
                        android:paddingStart="@dimen/_20sdp"
                        android:paddingEnd="@dimen/_20sdp"
