<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_12sdp"
                android:text="Update Data In ID Card"
                android:textAlignment="center"
                android:textColor="@color/blue"
                android:textSize="@dimen/_16ssp" />

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/georgia_italic"
                android:text="Kindly submit an application in the Fee office for updating the details in any one or more of the followings fields:"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textSize="@dimen/_14ssp" />

            <CheckBox
                android:id="@+id/studentPhotograph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:includeFontPadding="false"
                android:padding="@dimen/_5sdp"
                android:text="Student's Photograph"
                android:textSize="@dimen/_13sdp" />


            <CheckBox
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Name"
                android:textSize="@dimen/_13sdp" />


            <CheckBox
                android:id="@+id/dob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="DOB"
                android:textSize="@dimen/_13sdp" />

            <CheckBox
                android:id="@+id/bloodGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Blood Group"
                android:textSize="@dimen/_13sdp" />


            <CheckBox
                android:id="@+id/allergies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Allergies(if any)"
                android:textSize="@dimen/_13sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:fontFamily="@font/georgia_bold"
                android:text="In case of emergency, please contact"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp" />

            <CheckBox
                android:id="@+id/parentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Name"
                android:textSize="@dimen/_13sdp" />


            <CheckBox
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Address"
                android:textSize="@dimen/_13sdp" />


            <CheckBox
                android:id="@+id/mobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Mobile No."
                android:textSize="@dimen/_13sdp" />

            <CheckBox
                android:id="@+id/transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/blue"
                android:fontFamily="@font/georgia_bold"
                android:padding="@dimen/_5sdp"
                android:text="Transport"
                android:textSize="@dimen/_13sdp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/gray_scale" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ic_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:fontFamily="@font/georgia"
                android:gravity="center"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:text="Save"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />


            <TextView
                android:id="@+id/ic_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:backgroundTint="@color/red"
                android:fontFamily="@font/georgia"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:text="@string/cancel_txt"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_16sdp" />
    </LinearLayout>

</ScrollView>