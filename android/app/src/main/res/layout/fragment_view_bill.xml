                    app:layout_constraintStart_toStartOf="@id/tv_development_label"
                    app:layout_constraintTop_toBottomOf="@id/tv_development_label" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_portal_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/georgia"
                    android:gravity="start"
                    android:text="Portal Fee @ ₹ 150 p.m. For 12 Months"
