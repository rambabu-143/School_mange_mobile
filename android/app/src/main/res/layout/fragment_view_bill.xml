                    android:fontFamily="@font/georgia"

                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tv_payable_amount"
                    app:layout_constraintStart_toEndOf="@id/tv_first_amount"
