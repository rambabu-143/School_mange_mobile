<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.mountcarmelschools.ui.staffHomework.assignedHomeworkList.AssignedHomeworkListViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".ui.staffHomework.assignedHomeworkList.AssignedHomeworkListFragment">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/controls_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/select_start_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/georgia"
                            android:text="Select Start Date"
                            android:labelFor="@id/start_date_input"
                            android:textColor="@color/dark_gray"
                            android:textSize="@dimen/_10ssp"
                            android:layout_marginStart="@dimen/_5sdp"/>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/select_start_date_input_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_5sdp">
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/start_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_32sdp"
                                android:textSize="@dimen/_10ssp"
                                android:fontFamily="@font/georgia"
                                android:gravity="center_vertical"
                                android:layout_marginHorizontal="@dimen/_8sdp"
                                android:maxLines="1"
                                android:clickable="false"
                                android:drawableEnd="@drawable/ic_calendar"
                                android:drawablePadding="@dimen/_4sdp"
                                android:text="Select"
                                android:inputType="date" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/select_end_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/georgia"
                            android:text="Select End Date"
                            android:labelFor="@id/end_date_input"
                            android:textColor="@color/dark_gray"
                            android:textSize="@dimen/_10ssp"
                            android:layout_marginStart="@dimen/_5sdp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/select_end_date_input_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_5sdp">
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/end_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_32sdp"
                                android:textSize="@dimen/_10ssp"
                                android:layout_marginHorizontal="@dimen/_8sdp"
                                android:maxLines="1"
                                android:fontFamily="@font/georgia"
                                android:clickable="false"
                                android:drawableEnd="@drawable/ic_calendar"
                                android:drawablePadding="@dimen/_4sdp"
                                android:gravity="center_vertical"
                                android:text="Select"
                                android:inputType="date" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_button"
                        android:layout_width="60dp"
                        android:padding="0dp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:layout_gravity="bottom"
                        android:backgroundTint="@color/blue_container"
                        android:textSize="@dimen/_14sdp"
                        android:text="Go" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/search_input_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <EditText
                    android:id="@+id/search_input_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:background="@color/white"
                    android:drawableEnd="@drawable/ic_search"
                    android:drawableTint="@color/dark_gray"
                    android:fontFamily="@font/georgia"
                    android:hint="Find homework"
                    android:lines="1"
                    android:maxLines="1"
                    android:padding="@dimen/_8sdp"
                    android:inputType="text"
                    android:textSize="@dimen/_11ssp" />
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@color/staffBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/homeworks_list_refresh_controller"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/homeworks_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:paddingTop="@dimen/_12sdp"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:paddingBottom="@dimen/_48sdp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <TextView
                    android:id="@+id/empty_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:text="No Record Found"
                    android:textSize="@dimen/_16ssp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/homeworks_list_refresh_controller"
                    app:layout_constraintStart_toStartOf="@+id/homeworks_list_refresh_controller" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</layout>
