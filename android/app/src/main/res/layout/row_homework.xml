<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/homework"
        app:contentPadding="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@color/white"
        app:cardCornerRadius="@dimen/_2sdp"
        tools:context=".ui.homework.HomeworkFragment">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/homework_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/georgia"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="Test"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <LinearLayout
                    android:id="@+id/homework_date_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/calendar_line"
                        app:tint="@color/dark_gray"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/homework_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:text="@string/homework_assigned_on_date"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="horizontal"
                    android:layout_gravity="start"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/person_line"
                        app:tint="@color/dark_gray"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/teacher_name"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/_12sdp"
                        android:text="@string/homework_assigned_by" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homework_attachment_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:orientation="horizontal"
                    android:layout_gravity="start"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/homework_text">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:src="@drawable/file_line"
                        app:tint="@color/black"
                        android:layout_marginEnd="@dimen/_8sdp"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/attachment"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:fontFamily="@font/georgia"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp"
                        android:text="Attachment Link" />
                </LinearLayout>
            </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>