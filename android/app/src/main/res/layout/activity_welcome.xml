<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="modelView"
            type="com.mountcarmelschools.ui.welcome.WelcomeViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.welcome.WelcomeActivity">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_loginTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".12" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp"
            android:src="@drawable/ic_logo1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gl_loginTop" />

        <TextView
            android:id="@+id/txt_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo"
            android:padding="@dimen/_16sdp"
            android:textSize="@dimen/_24ssp"
            android:textColor="@color/black"
            android:fontFamily="@font/georgia_bold"
            android:text="@string/welcome" />

        <TextView
            android:id="@+id/txt_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_welcome"
            android:fontFamily="@font/georgia"
            android:textSize="@dimen/_14ssp"
            android:text="@string/login_as" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_login"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/img_staff"
                android:padding="@dimen/_1sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/img_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/img_parent"
                android:layout_marginTop="@dimen/_25sdp"
                android:onClick="@{modelView::onStaffClick}"
                android:src="@drawable/staff"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/img_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/img_staff"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/img_student"
                android:layout_marginTop="@dimen/_25sdp"
                android:padding="@dimen/_1sdp"
                android:onClick="@{modelView::onParentClick}"
                android:src="@drawable/parent"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/img_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_1sdp"
                app:layout_constraintStart_toEndOf="@+id/img_parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/_25sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:onClick="@{modelView::onStudentClick}"
                android:src="@drawable/student"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/txt_staff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_staff"
                app:layout_constraintEnd_toStartOf="@+id/img_parent"
                android:fontFamily="@font/georgia"
                android:textSize="@dimen/_16ssp"
                android:padding="@dimen/_5sdp"
                android:text="Staff"/>

            <TextView
                android:id="@+id/txt_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/img_parent"
                app:layout_constraintStart_toEndOf="@+id/txt_staff"
                app:layout_constraintEnd_toStartOf="@+id/img_student"
                android:fontFamily="@font/georgia"
                android:textSize="@dimen/_16ssp"
                android:padding="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_20sdp"
                android:text="Parent"/>

            <TextView
                android:id="@+id/txt_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/img_student"
                app:layout_constraintStart_toEndOf="@+id/img_parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:fontFamily="@font/georgia"
                android:textSize="@dimen/_16ssp"
                android:padding="@dimen/_5sdp"
                android:text="Student"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>